--- !tapi-tbd-v3
archs: [ arm64 ]
platform: ios
install-name: /usr/lib/libSystem.B.dylib
current-version: 1
compatibility-version: 1
exports:
  - archs: [ arm64 ]
    symbols: [ _getenv, _fopen, _fclose, _fflush, _fprintf, _vfprintf,
               _snprintf, _strcmp, _strstr, _strlen, _memcpy, _memcmp, _sleep, _pthread_create,
               _pthread_detach, _dladdr, _dlopen, _dlsym, _dlclose,
               __dyld_register_func_for_add_image, dyld_stub_binder ]
...
